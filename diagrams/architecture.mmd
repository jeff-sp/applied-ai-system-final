flowchart TD

    %% ---------- INPUT ----------
    U["User<br/>taste profile: genre, mood, target_energy"]
    CLI["CLI Runner<br/>src/main.py"]
    U --> CLI

    %% ---------- RETRIEVAL (the R in RAG) ----------
    subgraph RET["Retriever · src/retriever.py"]
        KB[("Music Knowledge Base<br/>data/songs.csv")]
        LOAD["load_songs()<br/>parse · type-cast · validate rows"]
        EVAL["evaluate_song()<br/>genre +1.5 · mood +0.5 · energy x2.0<br/>genre outranks mood 3:1<br/>emits a SignalMatch per signal"]
        RANK["rank_songs()<br/>sort by score, cut to top-k"]
        CONF["compute_confidence()<br/>0.6 x score + 0.4 x signal coverage<br/>band: high / medium / low"]
        KB --> LOAD --> EVAL --> RANK --> CONF
    end
    CLI -- "query: user_prefs, k" --> LOAD

    %% ---------- AUGMENTED GENERATION ----------
    subgraph GEN["Explanation Agent · src/explainer.py"]
        CTX["RetrievedSong<br/>song + score + signals + confidence"]
        CLAIM["build claims<br/>one per signal, hit or miss"]
        CHECK{"is_claim_grounded()<br/>supported by the record?"}
        PROSE["render prose<br/>wording constrained by band"]
        CTX --> CLAIM --> CHECK
        CHECK -- "yes" --> PROSE
    end
    CONF -- "top-k + evidence" --> CTX

    %% ---------- GUARDRAILS ----------
    GUARD["Guardrails & Logging<br/>src/guardrails.py · src/logging_setup.py<br/>skip malformed rows · reject/clamp bad profiles<br/>drop ungrounded claims · logs/run.log"]
    LOAD -.-> GUARD
    RANK -.-> GUARD
    CHECK -- "no: drop claim<br/>(withhold if none survive)" --> GUARD

    %% ---------- OUTPUT ----------
    OUT["Ranked recommendations<br/>+ grounded explanation + confidence<br/>+ run reliability report"]
    PROSE --> OUT
    OUT --> U

    %% ---------- VERIFICATION ----------
    subgraph EVALS["Evaluation & Human Check"]
        TEST["Automated Tester · 63 tests<br/>scoring · guardrails · confidence<br/>grounding · end-to-end CLI"]
        HUMAN["Human Review<br/>seven contrasting profiles:<br/>are picks, confidence + caveats sensible?"]
    end
    OUT --> TEST
    OUT --> HUMAN
    TEST -- "regressions" --> EVAL
    HUMAN -- "re-tune weights / thresholds" --> EVAL

    %% ---------- STYLES ----------
    classDef store fill:#e8eaf6,stroke:#3f51b5
    classDef check fill:#e8f5e9,stroke:#2e7d32
    classDef guard fill:#fff8e1,stroke:#f9a825
    class KB store
    class TEST,HUMAN check
    class GUARD guard
