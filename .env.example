# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Get a key at https://aistudio.google.com/apikey
# Without it the system still runs end to end on the offline hashing embedder
# and the deterministic template explainer - see README "Running offline".
GEMINI_API_KEY=<your-geminin-api-key>
